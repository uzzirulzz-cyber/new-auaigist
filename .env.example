# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/playbeat?retryWrites=true&w=majority"

# Auth
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# Admin credentials
ADMIN_EMAIL="admin@playbeat.digital"
ADMIN_PASSWORD="your-password"
ADMIN_NAME="PlayBeat Admin"

# Public config
NEXT_PUBLIC_APP_NAME="PlayBeat Digital"
NEXT_PUBLIC_APP_URL="https://playbeat.digital"

# Facebook OAuth
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="https://playbeat.digital/api/auth/facebook/callback"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://playbeat.digital/api/auth/google/callback"

# TikTok OAuth
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="https://playbeat.digital/api/auth/tiktok/callback"

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String // hashed
  name      String
  role      String   @default("admin") // admin | staff
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id          String   @id @default(cuid()) @map("_id")
  sku         String   @unique
  name        String
  description String?
  category    String?
  price       Float // USD base price
  currency    String   @default("USD") // base currency — always USD
  originalPrice Float? // original source price (e.g., 60 EUR)
  originalCurrency String? // original source currency (USD/EUR/GBP/TRY/JPY/AUD/BRL/COP/MXN)
  region      String? // US/EU/UK/Global etc.
  stock       Int      @default(0)
  status      String   @default("active") // active | draft | archived
  image       String?
  digital     Boolean  @default(true)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@map("products")
}

model Order {
  id           String     @id @default(cuid()) @map("_id")
  orderNumber  String     @unique
  customerName String
  customerEmail String?
  items        OrderItem[]
  total        Float
  currency     String     @default("Rs")
  status       String     @default("pending") // pending | processing | completed | cancelled
  paymentMethod String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// Embedded item (composite type for MongoDB)
type OrderItem {
  productId String
  name      String
  price     Float
  qty       Int
}

model Customer {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String   @unique
  phone     String?
  country   String?
  orders    Int      @default(0)
  totalSpent Float   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model Setting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id        String   @id @default(cuid()) @map("_id")
  action    String
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
